{
  "stepDefinitions": [
    "cypress/e2e/api/step_definitions/**/*.{js,ts}",
    "cypress/support/step_definitions/**/*.{js,ts}"
  ],
  "filterSpecs": true,
  "omitFiltered": true,
  "json": {
    "enabled": true,
    "output": "cypress/reports/cucumber-json/cucumber-report.json"
  },
  "html": {
    "enabled": true,
    "output": "cypress/reports/cucumber-html/index.html"
  },
  "messages": {
    "enabled": true,
    "output": "cypress/reports/cucumber-messages/cucumber-messages.ndjson"
  }
}